{
  "uid": "aeropuerto-estado",
  "title": "Aeropuerto: estado general",
  "description": "Tablero del ADR-011: tráfico y errores por servicio, objetivo del pedido de slot (11.3), reparto entre las instancias de Vuelos (ADR-012) y mensajes enviados a fallidos (11.4).",
  "tags": ["aeropuerto"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 39,
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pedido de slot: p95 actual",
      "description": "Percentil 95 de los pedidos de slot en los últimos 5 minutos, medido en Vuelos. Verde si está bajo el objetivo de 500 ms (11.3), rojo si lo pasa. Si no hubo pedidos, muestra \"Sin datos\" en gris.",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"vuelos\", http_route=\"/flights/:id/slot-request\"}[5m]))) or vector(NaN)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "noValue": "Sin datos",
          "mappings": [
            {
              "type": "special",
              "options": { "match": "null+nan", "result": { "text": "Sin datos", "color": "#6e7079" } }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Pedido de slot: p95 en el tiempo",
      "description": "La línea roja es el objetivo de 500 ms (11.3).",
      "gridPos": { "x": 8, "y": 0, "w": 16, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"vuelos\", http_route=\"/flights/:id/slot-request\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sin datos",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pedidos por segundo, por servicio",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "noValue": "Sin datos" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Errores por segundo (5xx), por servicio",
      "description": "Respuestas 5xx: errores del servicio, no rechazos de negocio como slot ocupado.",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "noValue": "Sin errores" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Reparto entre las instancias de Vuelos",
      "description": "Pedidos por segundo que atiende cada instancia (ADR-012). Necesita que las métricas lleven service.instance.id (pendiente del ADR-011).",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(http_server_request_duration_seconds_count{service_name=\"vuelos\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "noValue": "Sin datos" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Eventos enviados a fallidos",
      "description": "Líneas \"evento enviado a fallidos\" de los consumidores (11.4). Cada una dispara la alerta; el mensaje se revisa en el panel de RabbitMQ.",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (count_over_time({service_name=~\"vuelos|pistas\"} |= \"evento enviado a fallidos\" [$__interval]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Ninguno",
          "custom": { "drawStyle": "bars", "fillOpacity": 80 }
        }
      }
    }
  ]
}
