# Valores de ejemplo para el arranque local. Copiar como .env y cambiarlos.
# El archivo .env no se sube al repositorio.

MYSQL_VUELOS_ROOT_PASSWORD=cambiar
MYSQL_VUELOS_USER=vuelos
MYSQL_VUELOS_PASSWORD=cambiar
MYSQL_PISTAS_ROOT_PASSWORD=cambiar
MYSQL_PISTAS_USER=pistas
MYSQL_PISTAS_PASSWORD=cambiar
MYSQL_USUARIOS_ROOT_PASSWORD=cambiar
MYSQL_USUARIOS_USER=usuarios
MYSQL_USUARIOS_PASSWORD=cambiar
MONGO_CLIMA_USER=clima
MONGO_CLIMA_PASSWORD=cambiar
RABBITMQ_USER=aeropuerto
RABBITMQ_PASSWORD=cambiar

# Claves de los grupos que consumen Clima (9.15), con la forma grupo:clave,grupo:clave.
CLIMA_API_KEYS=demo:cambiar

# Clave con la que Usuarios firma los tokens y NGINX los verifica (15.5, 15.17).
# Tiene que tener al menos 32 bytes: si no, NGINX no arranca (15.21). Generala con:
#   openssl rand -base64 32
JWT_SECRET=cambiar-por-una-clave-generada-con-openssl

# Contraseñas de las cuentas de prueba de Usuarios (15.15): operador, aerolineas (AR) y latam (LA).
USUARIOS_OPERADOR_PASSWORD=cambiar
USUARIOS_AEROLINEAS_PASSWORD=cambiar
USUARIOS_LATAM_PASSWORD=cambiar
